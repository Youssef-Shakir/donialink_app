<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_task_manager" model="res.groups">
        <field name="name">Manage tasks</field>
        <field name="category_id" ref="module_category_donialink_app"/>
        <field name="comment">Creates and assigns tasks, sees every task of their companies.</field>
    </record>
    <record id="group_app_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_task_manager'))]"/>
    </record>

    <!-- assignees and the creator see their tasks; task managers see all the tasks of their companies -->
    <record id="rule_task_own" model="ir.rule">
        <field name="name">DoniaLink App: own tasks</field>
        <field name="model_id" ref="model_donialink_app_task"/>
        <field name="domain_force">['|', ('user_ids', 'in', user.id), ('creator_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_portal'))]"/>
    </record>
    <record id="rule_task_manager" model="ir.rule">
        <field name="name">DoniaLink App: tasks of my companies (managers)</field>
        <field name="model_id" ref="model_donialink_app_task"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_task_manager'))]"/>
    </record>
    <record id="rule_task_line_own" model="ir.rule">
        <field name="name">DoniaLink App: own task checklist</field>
        <field name="model_id" ref="model_donialink_app_task_line"/>
        <field name="domain_force">['|', ('task_id.user_ids', 'in', user.id), ('task_id.creator_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user')), (4, ref('base.group_portal'))]"/>
    </record>
    <record id="rule_task_line_manager" model="ir.rule">
        <field name="name">DoniaLink App: task checklist of my companies (managers)</field>
        <field name="model_id" ref="model_donialink_app_task_line"/>
        <field name="domain_force">[('task_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_task_manager'))]"/>
    </record>
</odoo>
