<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="kind_task_assigned" model="donialink.app.kind">
            <field name="code">task_assigned</field>
            <field name="name">Task assigned to me</field>
            <field name="description">A new task for you</field>
            <field name="icon">check</field>
            <field name="sequence">5</field>
            <field name="user_can_mute">False</field>
        </record>
        <record id="kind_task_due" model="donialink.app.kind">
            <field name="code">task_due</field>
            <field name="name">Task reminders</field>
            <field name="description">A task is due soon or overdue</field>
            <field name="icon">alert</field>
            <field name="sequence">6</field>
        </record>
        <record id="kind_task_done" model="donialink.app.kind">
            <field name="code">task_done</field>
            <field name="name">Task done</field>
            <field name="description">Someone finished a task you gave</field>
            <field name="icon">check</field>
            <field name="sequence">7</field>
        </record>
        <!-- roles: staff get their tasks; managers hear when tasks are done -->
        <record id="role_staff" model="donialink.app.role">
            <field name="kind_ids" eval="[(4, ref('kind_task_assigned')), (4, ref('kind_task_due'))]"/>
        </record>
        <record id="role_manager" model="donialink.app.role">
            <field name="group_ids" eval="[(4, ref('group_task_manager'))]"/>
            <field name="kind_ids" eval="[(4, ref('kind_task_done')), (4, ref('kind_task_due'))]"/>
        </record>
        <record id="role_owner" model="donialink.app.role">
            <field name="group_ids" eval="[(4, ref('group_task_manager'))]"/>
            <field name="kind_ids" eval="[(4, ref('kind_task_done'))]"/>
        </record>
    </data>
    <record id="screen_tasks" model="donialink.app.screen">
        <field name="key">tasks</field>
        <field name="name">My tasks</field>
        <field name="description">What to do today</field>
        <field name="icon">check</field>
        <field name="sequence">4</field>
        <field name="badge_model">donialink.app.task</field>
        <field name="badge_method">dl_app_task_badge</field>
    </record>
    <record id="screen_team_tasks" model="donialink.app.screen">
        <field name="key">team_tasks</field>
        <field name="name">Team tasks</field>
        <field name="description">Assign and follow</field>
        <field name="icon">box</field>
        <field name="sequence">5</field>
        <field name="group_ids" eval="[(6, 0, [ref('donialink_app.group_task_manager')])]"/>
    </record>
    <record id="cron_task_reminders" model="ir.cron">
        <field name="name">DoniaLink App: task reminders and repeats</field>
        <field name="model_id" ref="model_donialink_app_task"/>
        <field name="state">code</field>
        <field name="code">model._cron_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>
</odoo>
