<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_app_task_list" model="ir.ui.view">
        <field name="name">donialink.app.task.list</field>
        <field name="model">donialink.app.task</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-muted="state in ('done', 'cancelled')">
                <field name="priority" widget="priority" optional="show"/>
                <field name="name"/>
                <field name="user_ids" widget="many2many_avatar_user"/>
                <field name="deadline"/>
                <field name="state" widget="badge" decoration-info="state == 'progress'" decoration-success="state == 'done'"/>
                <field name="creator_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="is_overdue" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="view_app_task_kanban" model="ir.ui.view">
        <field name="name">donialink.app.task.kanban</field>
        <field name="model">donialink.app.task</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="is_overdue"/>
                <templates>
                    <t t-name="card">
                        <field name="priority" widget="priority"/>
                        <field name="name" class="fw-bold"/>
                        <field name="deadline" t-att-class="record.is_overdue.raw_value ? 'text-danger' : 'text-muted'"/>
                        <footer><field name="user_ids" widget="many2many_avatar_user"/></footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_app_task_form" model="ir.ui.view">
        <field name="name">donialink.app.task.form</field>
        <field name="model">donialink.app.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" invisible="state != 'todo'"/>
                    <button name="action_done" type="object" string="Done" class="btn-primary" invisible="state not in ('todo', 'progress')"/>
                    <button name="action_reset" type="object" string="Reopen" invisible="state not in ('done', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="todo,progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="priority" widget="priority" class="me-2"/><field name="name" placeholder="e.g. Clean the fryer"/></h1></div>
                    <group>
                        <group>
                            <field name="user_ids" widget="many2many_avatar_user"/>
                            <field name="deadline"/>
                            <field name="photo_required"/>
                        </group>
                        <group>
                            <field name="repeat"/>
                            <field name="repeat_weekdays" invisible="repeat != 'weekly'" placeholder="0,2,4 (0 = Monday)"/>
                            <field name="creator_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What to do…"/>
                    <notebook>
                        <page string="Checklist" name="checklist">
                            <field name="line_ids">
                                <list editable="bottom"><field name="sequence" widget="handle"/><field name="done"/><field name="name"/></list>
                            </field>
                        </page>
                        <page string="Done" name="done" invisible="state != 'done'">
                            <group>
                                <field name="done_by_id"/>
                                <field name="done_date"/>
                                <field name="done_note"/>
                            </group>
                            <field name="photo_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_app_task_search" model="ir.ui.view">
        <field name="name">donialink.app.task.search</field>
        <field name="model">donialink.app.task</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_ids"/>
                <filter name="open" string="Open" domain="[('state', 'in', ('todo', 'progress'))]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_creator" string="Created By" context="{'group_by': 'creator_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_app_task" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">donialink.app.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Give your team its first task</p>
            <p>Staff see their tasks in the DoniaLink App, tick the checklist and finish with a photo.</p>
        </field>
    </record>
</odoo>
