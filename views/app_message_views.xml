<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_app_message_list" model="ir.ui.view">
        <field name="name">donialink.app.message.list</field>
        <field name="model">donialink.app.message</field>
        <field name="arch" type="xml">
            <list create="false" decoration-muted="is_read" decoration-bf="not is_read">
                <field name="create_date" string="Sent"/>
                <field name="user_id"/>
                <field name="kind_id"/>
                <field name="title"/>
                <field name="preview" optional="show"/>
                <field name="attachment_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="sender" optional="hide"/>
                <field name="origin" optional="hide"/>
                <field name="pushed" optional="show"/>
                <field name="is_read"/>
            </list>
        </field>
    </record>

    <record id="view_app_message_form" model="ir.ui.view">
        <field name="name">donialink.app.message.form</field>
        <field name="model">donialink.app.message</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_push_again" type="object" string="Notify Phones Again"/>
                    <button name="action_mark_read" type="object" string="Mark Read" invisible="is_read"/>
                    <button name="action_mark_unread" type="object" string="Mark Unread" invisible="not is_read"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="title"/></h1></div>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="kind_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sender"/>
                            <field name="origin"/>
                        </group>
                        <group>
                            <field name="create_date" string="Sent"/>
                            <field name="pushed"/>
                            <field name="is_read"/>
                            <field name="read_date"/>
                            <field name="attachment_id"/>
                            <field name="url"/>
                        </group>
                    </group>
                    <field name="body"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_app_message_search" model="ir.ui.view">
        <field name="name">donialink.app.message.search</field>
        <field name="model">donialink.app.message</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <field name="user_id"/>
                <field name="kind_id"/>
                <filter name="unread" string="Unread" domain="[('is_read', '=', False)]"/>
                <filter name="with_file" string="With a File" domain="[('attachment_id', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="by_user" string="Person" context="{'group_by': 'user_id'}"/>
                    <filter name="by_kind" string="Kind" context="{'group_by': 'kind_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_app_message" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">donialink.app.message</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No message sent to the app yet</p>
            <p>Reports from DoniaLink and notifications from other modules appear here, one line per person.</p>
        </field>
    </record>
</odoo>
