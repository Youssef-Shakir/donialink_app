<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_app_role_list" model="ir.ui.view">
        <field name="name">donialink.app.role.list</field>
        <field name="model">donialink.app.role</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="user_type"/>
                <field name="is_default"/>
                <field name="user_count" string="People"/>
            </list>
        </field>
    </record>
    <record id="view_app_role_form" model="ir.ui.view">
        <field name="name">donialink.app.role.form</field>
        <field name="model">donialink.app.role</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_users" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="user_count" widget="statinfo" string="People"/>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" placeholder="e.g. Kitchen"/></h1></div>
                    <group>
                        <group>
                            <field name="user_type" widget="radio"/>
                            <field name="is_default"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="description"/>
                            <field name="company_ids" widget="many2many_tags" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="People" name="people"><field name="user_ids" widget="many2many_tags"/></page>
                        <page string="Access Groups" name="groups"><field name="group_ids" widget="many2many_tags"/></page>
                        <page string="Screens" name="screens"><field name="screen_ids" widget="many2many_tags"/></page>
                        <page string="Receives" name="kinds"><field name="kind_ids" widget="many2many_tags"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_app_role" model="ir.actions.act_window">
        <field name="name">Roles</field>
        <field name="res_model">donialink.app.role</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_app_admin" model="ir.actions.client">
        <field name="name">DoniaLink App</field>
        <field name="tag">donialink_app.admin_dashboard</field>
    </record>
</odoo>
